{
  "private": true,
  "name": "exam-simulator",
  "version": "1.8.0",
  "description": "محاكي الاختبارات الإحترافية لمركز الإبداع",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc -p tsconfig.node.json",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > api/_lib/database.types.ts"
  },
  "dependencies": {
    "@mantine/hooks": "^8.3.10",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "camelcase-keys": "^10.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "nodemailer": "^8.0.7",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.13.1",
    "sanitize-html": "^2.17.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "marked": "^18.0.9",
    "prettier": "^3.6.2",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.4"
  }
}
